{
  "name": "snakegame-ai",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "headless": "pnpm --filter @snake/engine headless",
    "headless:ai": "pnpm --filter @snake/ai headless",
    "headless:survival": "pnpm --filter @snake/ai headless:survival",
    "simulate": "pnpm --filter @snake/simulation simulate --",
    "replay": "pnpm --filter @snake/simulation replay --",
    "simulate:smoke": "pnpm --filter @snake/simulation smoke",
    "simulate:parallel-smoke": "node packages/simulation/dist/parallel-smoke.js",
    "simulate:worker-failure-smoke": "node packages/simulation/dist/worker-failure-smoke.js",
    "simulate:benchmark1000": "node packages/simulation/dist/benchmark.js 1000 100",
    "simulate:smoke10000": "node packages/simulation/dist/benchmark.js 10000 2",
    "preview:build": "pnpm --filter @snake/render-preview build",
    "renderer:resolution": "vitest run packages/renderer/test/viewport.test.ts apps/render-preview/test/preview-contract.test.ts",
    "renderer:soak": "vitest run packages/renderer/test/soak.test.ts",
    "check:renderer-boundaries": "node scripts/check-renderer-boundaries.mjs",
    "renderer:verify": "pnpm check:renderer-boundaries && pnpm renderer:resolution && pnpm renderer:soak && pnpm preview:build",
    "check:forbidden": "node scripts/check-forbidden-apis.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:forbidden && pnpm check:renderer-boundaries && pnpm headless && pnpm headless:ai && pnpm headless:survival && pnpm simulate:smoke && pnpm simulate:parallel-smoke && pnpm simulate:worker-failure-smoke"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
