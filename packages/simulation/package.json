{
  "name": "@snake/simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@snake/shared": "workspace:*",
    "@snake/engine": "workspace:*",
    "@snake/ai": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "simulate": "node dist/cli-entry.js simulate",
    "replay": "node dist/cli-entry.js replay",
    "smoke": "node dist/smoke.js"
  }
}
